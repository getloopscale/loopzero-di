{
  "name": "@getloopscale/loopzero-di-agent",
  "version": "0.2.0",
  "description": "Agent-first DI integration for @getloopscale/loopzero-di. Ships @InjectAgent() decorator + createAgentProvider() helper that produces a REQUEST-scoped Agent factory — so every HTTP request gets an isolated @getloopscale/loopzero-sdk Agent automatically.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/getloopscale/loopzero-di#readme",
  "bugs": "https://github.com/getloopscale/loopzero-di/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getloopscale/loopzero-di.git",
    "directory": "packages/di-agent"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "docs:json": "typedoc --options typedoc.json"
  },
  "keywords": [
    "dependency-injection",
    "di",
    "agent",
    "loopzero",
    "LoopZero"
  ],
  "peerDependencies": {
    "@getloopscale/loopzero-di": "^0.1.0-next.0",
    "@getloopscale/loopzero-sdk": "^1.3.0",
    "reflect-metadata": "^0.2.0"
  },
  "devDependencies": {
    "@swc/core": "^1.15.40",
    "@getloopscale/loopzero-di": "workspace:*",
    "@getloopscale/loopzero-sdk": "^1.9.0",
    "reflect-metadata": "^0.2.0",
    "tsup": "^8.5.0",
    "typedoc": "^0.28.19",
    "typescript": "^5.8.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.8",
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
